{
  "name": "jungle-wagering",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0 <2"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "demo": "bun scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 30000",
    "test:sqs": "bun test tests/sqs --timeout 90000",
    "check:all": "bun run check && bun run test:sqs",
    "db:migrate": "bun src/database/migrate.ts",
    "check": "bun run typecheck && bun run test && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1172.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
